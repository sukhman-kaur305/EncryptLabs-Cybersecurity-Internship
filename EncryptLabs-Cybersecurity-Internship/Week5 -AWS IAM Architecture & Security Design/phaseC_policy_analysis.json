  "findings": [
    {
      "entity": "intern_group",
      "policy_name": "AmazonS3ReadOnlyAccess",
      "risk_level": "Medium",
      "finding": "Managed policy provides broader S3 read permissions than required for the lab.",
      "recommendation": "Replace with a custom policy limited to the my-homelab-trail bucket."
    },
    {
      "entity": "intern_group",
      "policy_name": "EC2DescribeInstances",
      "risk_level": "Low",
      "finding": "Only the ec2:DescribeInstances action is allowed. Resource '*' is required for this API.",
      "recommendation": "Keep this least-privilege read-only permission."
    },
    {
      "entity": "intern_role",
      "policy_name": "AssumeRole Trust Policy",
      "risk_level": "Low",
      "finding": "Only the EC2 service principal is trusted to assume the role.",
      "recommendation": "Review trust relationships periodically and enable CloudTrail monitoring."
    }
  ],
  "recommended_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ListBucket",
        "Effect": "Allow",
        "Action": "s3:ListBucket",
        "Resource": "arn:aws:s3:::my-homelab-trail"
      },
      {
        "Sid": "ReadObjects",
        "Effect": "Allow",
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::my-homelab-trail/*"
      }
    ]
  },
  "summary": {
    "overall_risk": "Medium",
    "highest_priority": "Scope S3 access to the lab bucket only.",
    "bucket": "my-homelab-trail"
  }
}